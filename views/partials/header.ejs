<%# locals, because an error caught before the auth middleware ran has neither %>
<% const viewer = locals.user || { role: 'guest' } %>
<% const path = locals.currentPath || '' %>
<%# a section stays marked on every page inside it - Manage users is a
    section of its own, even though its address starts with /editor %>
<% const here = href => {
  if (path === href) return 'aria-current="page"'
  const inside = path.startsWith(href + '/') && !(href === '/editor' && path.startsWith('/editor/users'))
  return inside ? 'aria-current="true"' : ''
} %>
<header class="site-header">
  <nav>
    <a class="brand" href="/"><span>The</span> Daily Web</a>
    <div class="nav-right">
      <% if (viewer.role === 'guest') { %>
        <% if (path !== '/login') { %><a href="/login">Log in</a><% } %>
      <% } else { %>
        <% if (viewer.role === 'reporter') { %><a href="/reporter" <%- here('/reporter') %>>Reporter Space</a><% } %>
        <% if (viewer.role === 'editor') { %>
          <a href="/editor" <%- here('/editor') %>>Editor Space</a>
          <a href="/editor/users" <%- here('/editor/users') %>>Manage users</a>
        <% } %>
        <span class="who"><%= viewer.displayName %></span>
        <form method="post" action="/logout"><button type="submit">Log out</button></form>
      <% } %>
    </div>
  </nav>
</header>
