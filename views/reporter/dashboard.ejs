<%- include('../partials/head', { title: 'Reporter Space', extraCss: '/css/staff.css' }) %>
<%- include('../partials/header') %>

<main class="page">
  <div class="page-top">
    <h1>Reporter Space</h1>
    <a class="btn btn-primary" href="/reporter/article/new">New article</a>
  </div>

  <nav class="pills" aria-label="Filter by status">
    <a href="/reporter" class="pill<%= filter ? '' : ' active' %>">
      All <span class="pill-count"><%= counts.all %></span>
    </a>
    <% statuses.forEach(status => { %>
      <a href="/reporter?status=<%= status %>" class="pill<%= filter === status ? ' active' : '' %>">
        <%= STATUS_LABELS[status] %> <span class="pill-count"><%= counts[status] %></span>
      </a>
    <% }) %>
  </nav>

  <% if (articles.length === 0) { %>
    <p class="feed-empty muted">
      <%= filter ? 'No articles with this status.' : 'Nothing here yet. Start with a new article.' %>
    </p>
  <% } else { %>
    <ul class="list">
      <% articles.forEach(article => { %>
        <li class="list-item">
          <% if (article.draftContent.imagePath) { %>
            <a class="list-thumb" href="/reporter/article/<%= article._id %>" tabindex="-1" aria-hidden="true">
              <img src="<%= article.draftContent.imagePath %>" alt="" loading="lazy" width="160" height="107">
            </a>
          <% } %>

          <div class="list-body">
            <a class="list-title" href="/reporter/article/<%= article._id %>"><%= article.draftContent.title %></a>

            <% if (article.status === STATUS.NEEDS_REVISION && article.editorNote) { %>
              <p class="list-summary"><strong class="error">Editor:</strong> <%= article.editorNote %></p>
            <% } %>

            <div class="meta">
              <span class="badge status-<%= article.status %>"><%= STATUS_LABELS[article.status] %></span>
              <% if (article.isLive) { %><span class="badge live">Live</span><% } %>
              <span><%= CATEGORY_LABELS[article.draftContent.category] %></span>
              <span>edited <%= new Date(article.updatedAt).toLocaleDateString('en-GB') %></span>
            </div>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</main>

<%- include('../partials/footer') %>
