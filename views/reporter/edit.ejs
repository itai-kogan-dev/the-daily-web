<%- include('../partials/head', { title: article ? 'Edit article' : 'New article', extraCss: '/css/staff.css' }) %>
<%- include('../partials/header') %>

<%# the live version gets its own tab only while there is a change to it in
    progress - for a plain published article the two are the same %>
<% const showLive = article && article.isLive && article.status !== STATUS.PUBLISHED %>

<main class="page">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/reporter">Reporter Space</a>
  </nav>
  <h1><%= article ? content.title : 'New article' %></h1>

  <div class="workspace">
    <div class="workspace-main">
      <% if (showLive) { %>
        <%- include('../partials/version-tabs', { draftLabel: canEdit ? 'Your draft' : 'Sent for approval' }) %>
      <% } %>

      <div id="version-draft"<%- showLive ? ' role="tabpanel" aria-labelledby="tab-draft"' : '' %>>
        <% if (canEdit) { %>
          <form id="article-form" class="stack" data-id="<%= article ? article._id : '' %>">
            <%- include('../partials/article-fields') %>
          </form>
        <% } else { %>
          <%- include('../partials/article-pane', { label: 'Sent for approval', content }) %>
        <% } %>
      </div>

      <% if (showLive) { %>
        <div id="version-live" role="tabpanel" aria-labelledby="tab-live" hidden>
          <%- include('../partials/article-pane', { label: 'Live now · what readers see', content: article.publishedContent }) %>
        </div>
      <% } %>
    </div>

    <aside class="workspace-side">
      <section class="staff-panel">
        <p class="eyebrow">Status</p>
        <% if (article) { %>
          <div class="meta">
            <span id="status-badge" class="badge status-<%= article.status %>"><%= STATUS_LABELS[article.status] %></span>
            <% if (article.isLive) { %><span class="badge live">Live</span><% } %>
          </div>
          <div class="meta">
            <span><%= CATEGORY_LABELS[content.category] %></span>
            <% if (article.publishedAt) { %><span>Published <%= new Date(article.publishedAt).toLocaleDateString('en-GB') %></span><% } %>
            <span>Updated <%= new Date(article.updatedAt).toLocaleDateString('en-GB') %></span>
          </div>
        <% } else { %>
          <p class="hint">Not saved yet - it saves on its own as you write.</p>
        <% } %>
        <p id="save-status" class="save-status" role="status" aria-live="polite"></p>
      </section>

      <% if (article && article.status === STATUS.NEEDS_REVISION && article.editorNote) { %>
        <p class="editor-note"><strong>Editor asked for changes:</strong> <%= article.editorNote %></p>
      <% } %>

      <% if (article && article.isLive) { %>
        <p class="notice">
          Readers see the approved version until an editor approves your changes.
          <a href="/article/<%= article._id %>" target="_blank" rel="noopener">See what readers see</a>
        </p>
      <% } %>

      <% if (!canEdit) { %>
        <p class="notice warn">This article is with the editor, so it can't be changed right now.</p>
      <% } %>

      <div class="staff-panel side-actions" id="side-actions">
        <% if (canEdit) { %>
          <button id="submit-btn" type="button" class="btn btn-primary">Send to editor</button>
          <p id="submit-hint" class="hint">You can't edit it again until the editor replies.</p>
          <p id="submit-error" class="error" hidden></p>
        <% } %>
        <% if (canDelete) { %>
          <button id="delete-btn" type="button" class="btn btn-danger">Delete draft</button>
        <% } %>
      </div>
    </aside>
  </div>
</main>

<script src="/js/tabs.js"></script>
<script src="/js/read-error.js"></script>
<script src="/js/image-field.js"></script>
<script src="/js/autosave.js"></script>
<script src="/js/reporter-edit.js"></script>
<%- include('../partials/footer') %>
