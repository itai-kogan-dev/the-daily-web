<%- include('partials/head', { title: sort === 'popular' ? 'Most Read' : (category ? CATEGORY_LABELS[category] : 'Latest News') }) %>
<%- include('partials/header') %>

<div class="layout">
  <main class="page">
    <h1 id="feed-title"><%= sort === 'popular' ? 'Most Read' : (category ? CATEGORY_LABELS[category] : 'Latest News') %></h1>

    <!-- Every control below is a real link or a real form, so the feed works
         with JavaScript turned off. feed.js reads the data- attributes and
         takes over the same parameters without reloading the page. -->
    <div class="feed-toolbar">
      <form class="feed-search" method="get" action="/" role="search">
        <input type="search" name="q" value="<%= q %>" placeholder="Search headlines"
               aria-label="Search headlines" maxlength="80">
        <input type="hidden" name="category" value="<%= category || '' %>">
        <input type="hidden" name="sort" value="<%= sort %>">
      </form>

      <nav class="pills feed-sort" aria-label="Sort order">
        <a class="pill<%= sort === 'date' ? ' active' : '' %>" data-feed-nav data-sort="date"
           href="<%= feedLink({ sort: 'date' }) %>">Newest</a>
        <a class="pill<%= sort === 'popular' ? ' active' : '' %>" data-feed-nav data-sort="popular"
           href="<%= feedLink({ sort: 'popular' }) %>">Most Read</a>
      </nav>

      <%# feed.js renders the Unread only switch here, next to search and sort %>
      <span id="feed-unread-slot"></span>

      <span class="feed-count" id="feed-count">
        <%= total %> <%= total === 1 ? 'article' : 'articles' %>
      </span>
    </div>

    <p class="feed-status muted" id="feed-status" role="status" aria-live="polite" hidden></p>

    <!-- One container for the results, so the browser can replace the lot of it
         without having to work out which parts were on the page. The numbers let
         the script continue from the server-rendered page without refetching it. -->
    <div id="feed-results" data-page="<%= page %>" data-pages="<%= pages %>" data-total="<%= total %>" data-page-size="<%= pageSize %>">
      <% if (!items.length) { %>
        <p class="feed-empty muted">
          <% if (q || category) { %>
            Nothing matches that. <a data-feed-nav data-reset href="/">Show everything</a>.
          <% } else { %>
            Nothing has been published yet.
          <% } %>
        </p>
      <% } else { %>
        <ul class="list feed-list" id="feed-list">
          <% items.forEach(article => { %>
            <li class="list-item" data-article-id="<%= article.id %>">
              <% if (article.imagePath) { %>
                <a class="list-thumb" href="/article/<%= article.id %>" tabindex="-1" aria-hidden="true">
                  <img src="<%= article.imagePath %>" alt="" loading="lazy" width="160" height="107">
                </a>
              <% } %>

              <div class="list-body">
                <a class="list-title" href="/article/<%= article.id %>"><%= article.title %></a>
                <% if (article.summary) { %><p class="list-summary"><%= article.summary %></p><% } %>

                <div class="meta">
                  <a class="meta-category" data-feed-nav data-category="<%= article.category %>"
                     href="<%= feedLink({ category: article.category }) %>">
                    <%= article.categoryLabel %>
                  </a>
                  <span><%= article.authorName %></span>
                  <time datetime="<%= new Date(article.publishedAt).toISOString() %>">
                    <%= new Date(article.publishedAt).toLocaleDateString('en-GB') %>
                  </time>
                  <%# pinned to en-US so this matches the number public/js/feed.js writes %>
                  <span><%= Number(article.viewCount || 0).toLocaleString('en-US') %> views</span>
                </div>
              </div>
            </li>
          <% }) %>
        </ul>

        <% if (pages > 1) { %>
          <nav class="feed-pager" aria-label="Pages">
            <% if (page > 1) { %>
              <a class="btn btn-sm" data-feed-nav data-page="<%= page - 1 %>"
                 href="<%= feedLink({ page: page - 1 }) %>" rel="prev">Previous</a>
            <% } else { %><span></span><% } %>

            <div class="feed-pages">
              <% pageWindow(page, pages).forEach(entry => { %>
                <% if (entry.gap) { %>
                  <span class="muted" aria-hidden="true">&hellip;</span>
                <% } else if (entry.page === page) { %>
                  <%# not a link: the reader is already on this page %>
                  <span class="pill active" aria-current="page"><%= entry.page %></span>
                <% } else { %>
                  <a class="pill" data-feed-nav data-page="<%= entry.page %>"
                     href="<%= feedLink({ page: entry.page }) %>"><%= entry.page %></a>
                <% } %>
              <% }) %>
            </div>

            <% if (page < pages) { %>
              <a class="btn btn-sm" data-feed-nav data-page="<%= page + 1 %>"
                 href="<%= feedLink({ page: page + 1 }) %>" rel="next">Next</a>
            <% } else { %><span></span><% } %>
          </nav>
        <% } %>
      <% } %>
    </div>
  </main>
  <%- include('partials/sidebar') %>
</div>

<script src="/js/read.js"></script>
<script src="/js/feed.js"></script>
<script src="/js/weather.js" defer></script>
<%- include('partials/footer') %>
