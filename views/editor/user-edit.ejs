<%- include('../partials/head', { title: account ? 'Edit user' : 'New user', extraCss: '/css/staff.css' }) %>
<%- include('../partials/header') %>

<main class="page narrow">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/editor/users">Manage users</a>
  </nav>
  <h1><%= account ? account.displayName : 'New user' %></h1>

  <form id="user-form" class="stack" data-id="<%= account ? account._id : '' %>">
    <label>Username
      <input name="username" value="<%= account ? account.username : '' %>" autocomplete="username" required autofocus
             pattern="[A-Za-z0-9._\-]{3,30}" title="3-30 letters, numbers, dots, dashes or underscores">
    </label>

    <label>Display name
      <input name="displayName" value="<%= account ? account.displayName : '' %>" maxlength="60" required>
    </label>

    <% if (account) { %>
      <p class="hint">Role: <span class="badge role-<%= account.role %>"><%= ROLE_LABELS[account.role] %></span></p>
    <% } else { %>
      <label>Role
        <select name="role">
          <% STORED_ROLES.forEach(role => { %>
            <option value="<%= role %>"><%= ROLE_LABELS[role] %></option>
          <% }) %>
        </select>
      </label>
    <% } %>

    <label>Password
      <input name="password" type="password" autocomplete="new-password" minlength="8" <%= account ? '' : 'required' %>>
    </label>
    <% if (account) { %>
      <p class="hint">Leave the password blank to keep the current one.</p>
    <% } %>

    <p id="user-error" class="error" hidden></p>
    <div>
      <button type="submit" class="btn btn-primary"><%= account ? 'Save changes' : 'Create account' %></button>
    </div>
  </form>

  <% if (account && !isSelf) { %>
    <div class="danger-zone">
      <button id="delete-btn" type="button" class="btn btn-danger">Delete this account</button>
    </div>
  <% } %>
</main>

<script src="/js/read-error.js"></script>
<script src="/js/users.js"></script>
<%- include('../partials/footer') %>
