<%- include('../partials/head', { title: 'Editor Space', extraCss: '/css/staff.css' }) %>
<%- include('../partials/header') %>

<main class="page">
  <div class="page-top">
    <h1>Editor Space</h1>
    <a class="btn btn-ghost" href="/editor/analytics">Impact analytics</a>
  </div>

  <div class="desk-toolbar">
    <nav class="pills" aria-label="Filter by status">
      <a href="/editor" class="pill<%= filter ? '' : ' active' %>">
        All <span class="pill-count"><%= counts.all %></span>
      </a>
      <% statuses.forEach(status => { %>
        <a href="/editor?status=<%= status %>" class="pill<%= filter === status ? ' active' : '' %>">
          <%= STATUS_LABELS[status] %> <span class="pill-count"><%= counts[status] %></span>
        </a>
      <% }) %>
    </nav>
  </div>

  <% if (articles.length === 0) { %>
    <p class="desk-empty muted">
      <%= filter ? 'No articles with this status.' : 'Nothing here yet.' %>
    </p>
  <% } else { %>
    <ul class="list desk-list">
      <% articles.forEach(article => { %>
        <li class="list-item">
          <% if (article.draftContent.imagePath) { %>
            <a class="list-thumb" href="/editor/article/<%= article._id %>" tabindex="-1" aria-hidden="true">
              <img src="<%= article.draftContent.imagePath %>" alt="" loading="lazy" width="160" height="107">
            </a>
          <% } %>
          <div class="list-body">
            <a class="list-title" href="/editor/article/<%= article._id %>"><%= article.draftContent.title %></a>
            <% if (article.draftContent.summary) { %><p class="list-summary"><%= article.draftContent.summary %></p><% } %>
            <div class="meta">
              <span class="badge status-<%= article.status %>"><%= STATUS_LABELS[article.status] %></span>
              <% if (article.isLive) { %><span class="badge live">Live</span><% } %>
              <span><%= article.author && article.author.displayName ? article.author.displayName : 'Staff' %></span>
              <span><%= CATEGORY_LABELS[article.draftContent.category] %></span>
              <span>updated <%= new Date(article.updatedAt).toLocaleDateString('en-GB') %></span>
            </div>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</main>

<%- include('../partials/footer') %>
