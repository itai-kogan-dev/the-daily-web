<%- include('../partials/head', { title: 'Review article', extraCss: '/css/staff.css' }) %>
<%- include('../partials/header') %>

<% const showLive = article.isLive && article.publishedContent %>
<% const withReporter = !canEdit && article.status !== STATUS.PUBLISHED %>
<%# a tab for each version while there is a change to a live article %>
<% const compare = showLive && (canEdit || withReporter) %>

<main class="page" data-article="<%= article._id %>">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/editor">Editor Space</a>
  </nav>
  <h1><%= content.title %></h1>

  <div class="workspace">
    <div class="workspace-main">
      <% if (compare) { %>
        <%- include('../partials/version-tabs', { draftLabel: canEdit ? 'Waiting for approval' : "Reporter's draft" }) %>
      <% } %>

      <%# what is in progress: the editor's form while it waits for approval,
          the reporter's draft while it is with them %>
      <% if (canEdit || withReporter) { %>
        <div id="version-draft" role="tabpanel">
          <% if (canEdit) { %>
            <form id="review-form" class="stack">
              <%- include('../partials/article-fields') %>
            </form>
          <% } else { %>
            <%- include('../partials/article-pane', { label: "Reporter's draft · still being written", content: article.draftContent }) %>
          <% } %>
        </div>
      <% } %>

      <% if (showLive) { %>
        <div id="version-live" role="tabpanel"<%= compare ? ' hidden' : '' %>>
          <%- include('../partials/article-pane', { label: 'Live now · what readers see', content: article.publishedContent }) %>
        </div>
      <% } %>

      <section class="comments">
        <h2>Comments <span class="muted" id="comments-count"><%= comments.length %></span></h2>
        <p class="muted" id="comments-empty"<%= comments.length ? ' hidden' : '' %>>No comments yet.</p>
        <ul class="comment-list">
          <% comments.forEach(comment => { %>
            <li class="comment" data-comment="<%= comment._id %>">
              <div class="comment-head">
                <span class="comment-author"><%= comment.authorName %></span>
                <time datetime="<%= new Date(comment.createdAt).toISOString() %>"><%= new Date(comment.createdAt).toLocaleString('en-GB') %></time>
              </div>
              <p class="comment-body" data-body><%= comment.body %></p>
              <div class="comment-actions">
                <button type="button" class="btn btn-sm" data-edit>Edit</button>
                <button type="button" class="btn btn-sm btn-danger" data-delete>Delete</button>
              </div>
              <p class="error" data-error hidden></p>
            </li>
          <% }) %>
        </ul>
      </section>
    </div>

    <aside class="workspace-side">
      <section class="box">
        <p class="eyebrow">Status</p>
        <div class="meta">
          <span id="status-badge" class="badge status-<%= article.status %>"><%= STATUS_LABELS[article.status] %></span>
          <% if (article.isLive) { %><span class="badge live">Live</span><% } %>
        </div>
        <div class="meta">
          <span>By <%= article.author && article.author.displayName ? article.author.displayName : 'Staff' %></span>
          <span><%= CATEGORY_LABELS[content.category] %></span>
          <% if (article.publishedAt) { %><span>Published <%= new Date(article.publishedAt).toLocaleDateString('en-GB') %></span><% } %>
          <span>Updated <%= new Date(article.updatedAt).toLocaleDateString('en-GB') %></span>
        </div>
        <p id="review-status" class="save-status"></p>
      </section>

      <% if (hasDraft) { %>
        <p class="notice">Your unsent changes from an earlier visit are loaded. Only editors see them until you publish or send back.</p>
      <% } %>

      <% if (article.status === STATUS.NEEDS_REVISION && article.editorNote) { %>
        <p class="editor-note"><strong>Sent back:</strong> <%= article.editorNote %></p>
      <% } %>

      <% if (withReporter) { %>
        <p class="notice">This article is with the reporter. It can be edited, published or sent back once they send it for approval.</p>
      <% } %>

      <div class="side-actions">
        <% if (canEdit) { %>
          <button id="publish-btn" type="button" class="btn btn-primary">Publish</button>
        <% } %>
        <% if (canDelete) { %>
          <button id="delete-btn" type="button" class="btn btn-danger">Delete article</button>
        <% } %>
        <p id="review-error" class="error" hidden></p>
      </div>

      <% if (canEdit) { %>
        <section class="stack side-section">
          <label>Send back to the reporter
            <textarea id="return-note" rows="3" maxlength="1000" placeholder="What should the reporter fix?"></textarea>
          </label>
          <button id="return-btn" type="button" class="btn">Send back with note</button>
        </section>
      <% } %>

      <% if (article.updateEvents && article.updateEvents.length) { %>
        <section class="side-section">
          <p class="eyebrow">Update history</p>
          <ul class="history">
            <% article.updateEvents.forEach(event => { %>
              <li>Approved <%= new Date(event.at).toLocaleString('en-GB') %><% if (event.editor && event.editor.displayName) { %> by <%= event.editor.displayName %><% } %></li>
            <% }) %>
          </ul>
        </section>
      <% } %>
    </aside>
  </div>
</main>

<script src="/js/tabs.js"></script>
<script src="/js/read-error.js"></script>
<script src="/js/image-field.js"></script>
<script src="/js/autosave.js"></script>
<script src="/js/review.js"></script>
<%- include('../partials/footer') %>
