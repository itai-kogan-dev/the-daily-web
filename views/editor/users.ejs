<%- include('../partials/head', { title: 'Staff accounts', extraCss: '/css/staff.css' }) %>
<%- include('../partials/header') %>

<main class="page">
  <div class="page-top">
    <h1>Staff accounts</h1>
    <a class="btn btn-primary" href="/editor/users/new">New user</a>
  </div>

  <p class="muted">Reporters write articles. Editors review them and manage these accounts.</p>

  <% if (users.length === 0) { %>
    <p class="feed-empty muted">No accounts yet.</p>
  <% } else { %>
    <ul class="list">
      <% users.forEach(account => { %>
        <li class="list-item" data-user="<%= account._id %>">
          <div class="list-body">
            <a class="list-title" href="/editor/users/<%= account._id %>"><%= account.displayName %></a>
            <% if (String(account._id) === currentUserId) { %><span class="muted">(you)</span><% } %>
            <div class="meta">
              <span class="badge role-<%= account.role %>"><%= ROLE_LABELS[account.role] %></span>
              <span>@<%= account.username %></span>
              <span>joined <%= new Date(account.createdAt).toLocaleDateString('en-GB') %></span>
            </div>
            <p class="error" data-error hidden></p>
          </div>
          <div class="list-actions">
            <a class="btn btn-sm" href="/editor/users/<%= account._id %>">Edit</a>
            <% if (String(account._id) !== currentUserId) { %>
              <button type="button" class="btn btn-sm btn-danger" data-delete>Delete</button>
            <% } %>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</main>

<script>
(function () {
  async function readError(res) {
    try {
      const data = await res.json()
      return data.error || 'Something went wrong'
    } catch (err) {
      return 'Something went wrong'
    }
  }

  document.querySelectorAll('[data-user]').forEach(row => {
    const deleteBtn = row.querySelector('[data-delete]')
    const errorEl = row.querySelector('[data-error]')
    if (!deleteBtn) return

    deleteBtn.addEventListener('click', async () => {
      const name = (row.querySelector('.list-title') || {}).textContent || 'this account'
      if (!window.confirm(`Delete ${name.trim()}? This cannot be undone.`)) return

      errorEl.hidden = true
      deleteBtn.disabled = true

      const res = await fetch(`/editor/api/users/${row.getAttribute('data-user')}`, {
        method: 'DELETE'
      }).catch(() => null)

      if (!res || !res.ok) {
        deleteBtn.disabled = false
        errorEl.textContent = !res ? 'Server unreachable, try again' : await readError(res)
        errorEl.hidden = false
        return
      }

      row.remove()
    })
  })
})()
</script>
<%- include('../partials/footer') %>
