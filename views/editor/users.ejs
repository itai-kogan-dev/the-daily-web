<%- include('../partials/head', { title: 'Manage users', extraCss: '/css/staff.css' }) %>
<%- include('../partials/header') %>

<main class="page">
  <div class="page-top">
    <h1>Manage users</h1>
    <a class="btn btn-primary" href="/editor/users/new">New user</a>
  </div>

  <p class="muted">Reporters write articles. Editors review them and manage these accounts.</p>

  <% if (users.length === 0) { %>
    <p class="feed-empty muted">No accounts yet.</p>
  <% } else { %>
    <ul class="list">
      <% users.forEach(account => { %>
        <li class="list-item" data-user="<%= account._id %>">
          <div class="list-body">
            <a class="list-title" href="/editor/users/<%= account._id %>"><%= account.displayName %></a>
            <% if (String(account._id) === currentUserId) { %><span class="muted">(you)</span><% } %>
            <div class="meta">
              <span class="badge role-<%= account.role %>"><%= ROLE_LABELS[account.role] %></span>
              <span>@<%= account.username %></span>
              <span>joined <%= new Date(account.createdAt).toLocaleDateString('en-GB') %></span>
            </div>
            <p class="error" data-error hidden></p>
          </div>
          <div class="list-actions">
            <a class="btn btn-sm" href="/editor/users/<%= account._id %>">Edit</a>
            <% if (String(account._id) !== currentUserId) { %>
              <button type="button" class="btn btn-sm btn-danger" data-delete>Delete</button>
            <% } %>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</main>

<script src="/js/read-error.js"></script>
<script src="/js/users.js"></script>
<%- include('../partials/footer') %>
