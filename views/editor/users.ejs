<%- include('../partials/head', { title: 'Staff accounts', extraCss: '/css/reporter.css' }) %>
<link rel="stylesheet" href="/css/editor.css">
<%- include('../partials/header') %>

<main class="page">
  <div class="page-top">
    <h1>Staff accounts</h1>
    <a class="button" href="/editor/users/new">New user</a>
  </div>

  <p class="muted">Reporters write articles, editors review them and manage these accounts.</p>

  <% if (users.length === 0) { %>
    <p class="muted">No accounts yet.</p>
  <% } else { %>
    <ul class="article-list" id="user-list">
      <% users.forEach(account => { %>
        <li class="article-row" data-user="<%= account._id %>">
          <div class="article-body">
            <a class="article-title" href="/editor/users/<%= account._id %>">
              <%= account.displayName %>
            </a>
            <% if (String(account._id) === currentUserId) { %><span class="muted">(you)</span><% } %>
            <div class="article-meta">
              <span class="badge role-<%= account.role %>"><%= ROLE_LABELS[account.role] %></span>
              <span>@<%= account.username %></span>
              <span>joined <%= new Date(account.createdAt).toLocaleDateString() %></span>
            </div>
            <p class="error" data-error hidden></p>
          </div>
          <div class="user-actions">
            <a class="button-secondary" href="/editor/users/<%= account._id %>">Edit</a>
            <% if (String(account._id) !== currentUserId) { %>
              <button type="button" class="button-secondary danger-text" data-delete>Delete</button>
            <% } %>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } %>
</main>

<script src="/js/users.js"></script>
<%- include('../partials/footer') %>
