# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# MongoDB Atlas connection string (Connect -> Drivers -> Node.js).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/thedailyweb?retryWrites=true&w=majority

# Any long random string. Signs the session cookie so it cannot be forged.
SESSION_SECRET=replace-with-a-long-random-string

PORT=3000

# Password given to every user created by "npm run seed". Pick anything.
SEED_PASSWORD=

# Sidebar weather widget (T4). Open-Meteo needs no API key - these only pick
# the place. Leave them out for Tel Aviv.
WEATHER_CITY=Tel Aviv
WEATHER_LAT=32.08
WEATHER_LON=34.78
