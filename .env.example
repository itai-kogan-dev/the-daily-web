# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# MongoDB Atlas connection string (Connect -> Drivers -> Node.js).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/thedailyweb?retryWrites=true&w=majority

# Any long random string. Signs the session cookie so it cannot be forged.
SESSION_SECRET=replace-with-a-long-random-string

PORT=3000

# Password given to every user created by "npm run seed". Pick anything.
SEED_PASSWORD=
